# =============================================================================
# AnyTools — environment variables
# =============================================================================
# Local dev: copy to apps/web/.env.local + leave defaults below.
# Coolify prod: set each REQUIRED key in the app's Environment Variables panel.
# Tier: [R]equired in prod / [O]ptional (feature disabled if missing).
# =============================================================================

# ---- [R] Public site URL ----------------------------------------------------
# Used for canonical, hreflang, OG image base URL, sitemap, Better Auth callbacks.
# Production MUST be the full origin including https (no trailing slash).
NEXT_PUBLIC_URL=http://localhost:3000

# ---- [R-prod] Better Auth secret --------------------------------------------
# 32+ random bytes. Generate: `openssl rand -base64 32`.
# Required in production for session cookie signing.
BETTER_AUTH_SECRET=

# ---- [R-prod] Auth DB path --------------------------------------------------
# SQLite file path. In Coolify, mount a persistent volume at this path so
# user sessions survive container restarts. Default: ./auth.db (process.cwd()).
AUTH_DB_PATH=/data/auth.db

# ---- [R-prod] Platform Postgres (shared content DB) ------------------------
# Postgres connection string used by @anytools/db-shared.
# Stores: projects, blogs (MDX mirror), affiliate_products, analytics_events.
# Source of truth = MDX in git; Postgres is regenerable via `pnpm sync:blogs`.
# Coolify: provision a PostgreSQL service, use the internal hostname.
#   postgres://postgres:<pw>@postgres:5432/postgres
# Local dev:
#   postgres://postgres:devpass@localhost:5432/anytools_platform
DATABASE_URL=
DATABASE_POOL_MAX=10

# ---- [O] GitHub OAuth (sign-in via GitHub) ----------------------------------
# Both must be set to enable. OAuth callback URL:
#   {NEXT_PUBLIC_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- [O] Currency converter — Open Exchange Rates fallback ------------------
# Frankfurter (ECB rates, no key) is the primary source.
# OXR fills gaps for non-ECB currencies. Free tier: 1000 req/mo at openexchangerates.org.
OXR_APP_ID=

# ---- [O] Newsletter — Resend ------------------------------------------------
# Both must be set to enable newsletter signup. Sign up at resend.com.
RESEND_API_KEY=
RESEND_AUDIENCE_ID=

# ---- [O] Plausible Analytics — consent-gated --------------------------------
# Domain = property name in Plausible (usually your site host).
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_SCRIPT_SRC=https://plausible.io/js/script.js

# ---- [O] Google AdSense — post-launch (set after content cluster spotlights) ----
# AdSense publisher client ID, e.g. ca-pub-XXXXXXXXXXXXXX. Empty = no ads.
NEXT_PUBLIC_ADSENSE_CLIENT=

# ---- [O] Better Auth public base URL ----------------------------------------
# Usually unnecessary — auth-client derives from window.location.
# Set only if Coolify/Cloudflare strips Host header and OAuth callback fails.
NEXT_PUBLIC_AUTH_BASE_URL=

# ---- [O] Self-host mode ------------------------------------------------------
# NOT a runtime env var — a BUILD-ARG baked in at `next build` (see
# src/lib/self-hosted.ts). `docker run -e NEXT_PUBLIC_SELF_HOSTED=1 …` has no effect;
# it must be passed as `--build-arg NEXT_PUBLIC_SELF_HOSTED=1` when the image is built.
# The two accepted values are unset (hosted, default — ads/analytics/auth/newsletter/
# blog/sitemap/canonical all on) and "1" (self-host — all of the above off, no
# BETTER_AUTH_SECRET or DATABASE_URL needed). There is no partial/mixed mode: this flag
# decides which of the two published images (`anytools-web` vs `anytools`) you are
# building, not a toggle within one image.
NEXT_PUBLIC_SELF_HOSTED=
