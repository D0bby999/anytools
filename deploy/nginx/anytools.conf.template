# AnyTools — nginx in front of `web` ONLY. The API is not upstream of this file
# and has no route from the internet (docs/architecture.md).
#
# Rendered by the nginx image's envsubst step: ${ANYTOOLS_DOMAIN} is the only
# variable. nginx's own $variables are left alone because envsubst in the
# official image only substitutes variables that are set in the environment.

# Open event streams per client address (security audit F-6). This file is
# included inside nginx's http block, so the zone is declared here.
limit_conn_zone $binary_remote_addr zone=lp_streams:10m;

server {
    listen 80;
    listen [::]:80;
    server_name ${ANYTOOLS_DOMAIN};

    # certbot renewals (webroot).
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${ANYTOOLS_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${ANYTOOLS_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${ANYTOOLS_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Uploads are capped at 50 MB by the API; a little headroom for multipart.
    client_max_body_size 55m;

    # Server-sent events (chat turns, document status): no buffering, and a
    # read timeout longer than any answer.
    location /app/api/stream/ {
        limit_conn lp_streams 24;
        limit_conn_status 429;
        proxy_pass http://web:3000;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-AnyTools-User-Id "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
    }

    location / {
        proxy_pass http://web:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        # Defence in depth: the identity header is the BFF's to set toward the
        # API, never a browser's. `web` does not forward inbound headers to the
        # API, and this makes sure it never sees one either.
        proxy_set_header X-AnyTools-User-Id "";
        proxy_read_timeout 120s;
    }
}
