{
  "name": "dobby-platform",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @anytools/web dev",
    "build": "pnpm -r --filter=!@anytools/config build",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "test": "pnpm -r test",
    "clean": "pnpm -r exec rm -rf .next dist build node_modules && rm -rf node_modules",
    "blog:new": "node scripts/blog-new.mjs",
    "blog:validate": "node scripts/blog-validate.mjs",
    "blog:publish-check": "node scripts/blog-publish-check.mjs",
    "blog:publish-db": "node scripts/blog-publish-db.mjs",
    "blog:analytics": "node --env-file=.env.local scripts/blog-analytics.mjs",
    "blog:affiliate-audit": "node scripts/blog-affiliate-audit.mjs",
    "sync:prod": "bash scripts/sync-blogs-prod.sh"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1057.0",
    "@biomejs/biome": "1.9.4",
    "gray-matter": "4.0.3",
    "playwright": "^1.60.0",
    "prompts": "^2.4.2",
    "typescript": "5.7.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "better-auth"
    ]
  }
}
