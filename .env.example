# AnyTools environment. Copy to .env and fill in.
# Never commit .env — .gitignore already excludes it.

# ---- database ---------------------------------------------------------------
POSTGRES_USER=anytools
POSTGRES_PASSWORD=change-me-to-something-random
POSTGRES_DB=anytools

# Host `postgres` is the compose service name; both `api` and `migrate` use it.
ANYTOOLS_POSTGRES_DSN=postgres://anytools:change-me-to-something-random@postgres:5432/anytools?sslmode=disable

# ---- secrets (required; the API refuses to boot without them) ----------------
# Shared bearer proving to the API that a caller is the BFF.
#   openssl rand -hex 32
ANYTOOLS_GATEWAY_TOKEN=

# AES-256-GCM key protecting BYOK credentials at rest.
# 64 hex chars, 44 base64 chars, or 32 raw bytes.
#   openssl rand -hex 32
#
# CHANGING THIS AFTER FIRST BOOT MAKES EVERY STORED SECRET UNREADABLE. The API
# verifies it against a sentinel row and refuses to start on a mismatch, which
# is what stops a wrong key from silently writing a second generation of
# unreadable data. Escrow it (phase 12).
ANYTOOLS_ENCRYPTION_KEY=

# Signing secret for the session and OAuth-state cookies.
#   openssl rand -hex 32
ANYTOOLS_SESSION_SECRET=

# ---- app --------------------------------------------------------------------
# Public origin. OAuth redirect URIs are built from this, NOT from the inbound
# Host header, so it must match what is registered with each provider exactly.
# The API reads it too: a review reminder's push opens a page on it, and it is
# the VAPID subject push services see (Apple wants https in production).
ANYTOOLS_APP_URL=http://localhost:3000
WEB_PORT=3000

# Compose defaults this to "production", which is also what refuses
# ANYTOOLS_ALLOW_NO_AUTH=1. Set it to "development" here for local work — an
# explicit opt-out, so forgetting it leaves you safe rather than exposed.
ANYTOOLS_ENV=development

# ---- OAuth: Google ----------------------------------------------------------
# Google Cloud console → APIs & Services → Credentials → OAuth client ID
#   Application type: Web application
#   Authorized redirect URI: <ANYTOOLS_APP_URL>/auth/callback/google
#   Scopes: openid, email, profile   (Drive asks for drive.file separately, below)
# The SAME client serves Google Drive (phase 13); both web and api read it.
ANYTOOLS_GOOGLE_CLIENT_ID=
ANYTOOLS_GOOGLE_CLIENT_SECRET=

# ---- Google Drive connector (phase 13) --------------------------------------
# Optional. With any of the four Google values unset, the Drive UI is simply
# absent. What to set up first:
#   - Enable the Google Drive API AND the Google Picker API on the project.
#   - Consent screen: add scope https://www.googleapis.com/auth/drive.file
#   - On the OAuth client above, add a SECOND authorized redirect URI:
#       <ANYTOOLS_APP_URL>/auth/drive/callback
# Browser API key (Credentials → API key), restricted to the Drive + Picker APIs
# and to the HTTP referrer <ANYTOOLS_APP_URL>/*. Sent to the browser by design:
# the Picker runs there. Not a secret, but unrestricted it is someone's quota.
ANYTOOLS_GOOGLE_API_KEY=
# The project NUMBER (Dashboard → Project info), not the project id. Under
# drive.file this is what makes a Picker selection a grant to this app.
ANYTOOLS_GOOGLE_PICKER_APP_ID=

# ---- OAuth: GitHub ----------------------------------------------------------
# GitHub → Settings → Developer settings → OAuth Apps → New OAuth App
#   Authorization callback URL: <ANYTOOLS_APP_URL>/auth/callback/github
#   Scope requested: user:email
ANYTOOLS_GITHUB_CLIENT_ID=
ANYTOOLS_GITHUB_CLIENT_SECRET=

# ---- optional overrides (sane defaults; compose sets what it needs) ----------
# Where the API listens INSIDE its container. Never published to the host.
# ANYTOOLS_SERVER_ADDR=:8080

# Where the BFF finds the API. `api` is the compose service name.
# ANYTOOLS_API_URL=http://api:8080

# Per-user request budget on the API. 0 disables rate limiting.
# ANYTOOLS_RATE_LIMIT_RPM=600
# ANYTOOLS_RATE_LIMIT_BURST=60

# Migration directory for `anytools migrate`. The image ships them at /app/migrations.
# ANYTOOLS_MIGRATIONS_DIR=migrations

# ---- BYOK (phase 4) ----------------------------------------------------------
# AnyTools has NO platform keys. Users connect their own accounts; nothing below
# is a credential for the product, and none of it is required to run.

# Experimental subscription lanes: the ChatGPT relay and Gemini Code Assist.
# OFF unless this is exactly "1".
#
# Read before enabling. Neither lane is licensed for proxying. The ChatGPT lane
# makes this server present itself to chatgpt.com as the first-party Codex CLI
# running on the user's own machine, and the account may be restricted. The
# Gemini lane requests `cloud-platform` scope, so the refresh token it stores is
# a full Google Cloud credential for that user, not an AI quota. An ordinary API
# key is the reliable path; these exist because the owner asked for them, and
# they are off for everyone else.
# ANYTOOLS_EXPERIMENTAL_SUBSCRIPTION_LANES=1

# The Gemini Code Assist lane needs a Google OAuth client of YOUR OWN. postclaw
# hardcodes a third party's published installed-app id and secret for this;
# AnyTools deliberately does not ship those, so without this pair the lane
# reports itself unavailable instead of impersonating someone else's app.
# ANYTOOLS_GEMINI_SUB_CLIENT_ID=
# ANYTOOLS_GEMINI_SUB_CLIENT_SECRET=
# Comma-separated redirect URIs registered on that client. The consent link
# and the code exchange accept only these (security audit F-10).
# ANYTOOLS_GEMINI_SUB_REDIRECT_URIS=

# Allows a BYOK api_base that points at a private or loopback address, for an
# operator running a self-hosted model. It disables the SSRF guard on BYOK
# egress at BOTH the write-time check and the connect-time dialer.
#
# NEVER set this on a hosted, multi-user deployment: any user could then point a
# connection at the instance metadata service and read its credentials.
# ANYTOOLS_BYOK_ALLOW_PRIVATE_ENDPOINTS=1

# Set to "off" to accept a streamed completion that never sent [DONE]. The guard
# is on by default because a proxy closing a connection mid-generation would
# otherwise truncate an answer silently.
# ANYTOOLS_PROVIDER_REQUIRE_STREAM_DONE=off
# Where uploaded documents and parsed Markdown are written. It must NOT be
# inside any web root: nothing under it is reachable by URL, which is what stops
# an uploaded .html from being served back to a browser as same-origin content.
# In compose this is a named volume; back it up with the database (phase 12).
# ANYTOOLS_DATA_DIR=./data
# A learner who keeps their files in their own Google Drive still has them read
# here (re-parse, playback, transcription). Recently read ones are cached under
# ANYTOOLS_DATA_DIR/cache, least recently used first out, up to this many MB.
# ANYTOOLS_DRIVE_CACHE_MB=2048
# Optional: keep learners' originals and objects (uploads, recordings, audio,
# exam papers) in a private Cloudflare R2 bucket instead of ANYTOOLS_DATA_DIR,
# which still holds parsed Markdown and scratch files. All four or none; the
# API checks the bucket at boot and refuses to start if it does not answer.
# Make an R2 API token with Object Read & Write on this bucket only; its "Access
# Key ID" and "Secret Access Key" go here. Files already in ANYTOOLS_DATA_DIR
# are still read from there until written again.
# ANYTOOLS_R2_ACCOUNT_ID=
# ANYTOOLS_R2_BUCKET=
# ANYTOOLS_R2_ACCESS_KEY_ID=
# ANYTOOLS_R2_SECRET_ACCESS_KEY=

# Background workers. The API is single-replica by rule (docs/architecture.md),
# so this is the whole parallelism of document processing. The lease is how long
# a claimed job is good for without a heartbeat — long enough that a slow
# provider call does not lose the job to the reaper (Spike B measured parse
# batches at 75-200 s, and the worker heartbeats between them).
# ANYTOOLS_JOB_WORKERS=2
# ANYTOOLS_JOB_LEASE_SECONDS=120

# Built-in transcription (docs/deployment.md, "Built-in transcription"): the
# server's own Whisper, run by the compose profile `stt`. Unset, the option is
# simply not offered; learners transcribe with their own Groq, OpenAI or
# Gemini key, or upload subtitles. Minutes are each learner's audio per local
# day on this engine.
# ANYTOOLS_STT_URL=http://stt:8000
# ANYTOOLS_STT_MODEL=Systran/faster-whisper-small
# ANYTOOLS_STT_DAILY_MINUTES=120
# Built-in voices (docs/deployment.md, "Built-in voices"): the server's own
# Kokoro, run by the compose profile `tts`. Unset, the option is not offered;
# learners speak overviews with their own OpenAI key or speech server, or in
# the browser. Minutes are each learner's speech per local day on this engine.
# ANYTOOLS_TTS_URL=http://tts:8880
# ANYTOOLS_TTS_DAILY_MINUTES=60
# The media tools, when not on PATH as yt-dlp and ffmpeg (the image has both).
# ANYTOOLS_YTDLP_BIN=yt-dlp
# ANYTOOLS_FFMPEG_BIN=ffmpeg

# ---- local development only --------------------------------------------------
# Test database DSN. CI sets this too; when CI=1 a missing database FAILS the
# suite instead of skipping it.
# ANYTOOLS_TEST_DSN=postgres://localhost:5432/anytools_test?sslmode=disable

# Disables the gateway bearer check. Refused when ANYTOOLS_ENV=production.
# ANYTOOLS_ALLOW_NO_AUTH=1

# ── Production (deploy/docker-compose.prod.yml, phase 12) ─────────────────────
# The public hostname nginx serves and certbot issues a certificate for.
ANYTOOLS_DOMAIN=
# Where Let's Encrypt sends expiry notices. Used once, by setup-server.sh.
LETSENCRYPT_EMAIL=
# rsync destination for the hourly off-box backup copy, e.g.
# backup@storage.example.com:/srv/anytools. backup.sh refuses to run in compose
# mode without it: a backup that never leaves the VPS dies with the VPS.
# The ENCRYPTION KEY is never part of a backup — escrow it separately.
ANYTOOLS_BACKUP_REMOTE=
# Interface `web` publishes on. Loopback by default; in production only nginx
# faces the internet and it reaches `web` over the compose network.
WEB_BIND=127.0.0.1
